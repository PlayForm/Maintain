{
	"compilerOptions": {
		"lib": ["ESNext", "DOM", "DOM.Iterable"],

		"outDir": "Target",

		"paths": {
			"@Class/*": ["./Source/Class/*"],

			"@Command/*": ["./Source/Command/*"],

			"@Configuration/*": ["./Source/Configuration/*"],

			"@Function/*": ["./Source/Function/*"],

			"@Interface/*": ["./Source/Interface/*"],

			"@Type/*": ["./Source/Type/*"],

			"@Variable/*": ["./Source/Variable/*"]
		},

		"rootDir": "./Source"
	},

	"extends": "@playform/build/tsconfig",

	"include": ["Source"]
}
